# Nginx edge của backend (make nxl-up-all trong nexuslive-be). Có giá trị thì /v1 và /hls đi qua edge,
# các biến bên dưới bị bỏ qua.
VITE_DEV_GATEWAY_URL=http://localhost:8080
# Khi không dùng edge: Vite định tuyến theo tiền tố tới từng service.
VITE_DEV_IDENTITY_URL=http://localhost:8090
VITE_DEV_STREAM_URL=http://localhost:8092
# Bucket MinIO chứa HLS; /hls/... được chuyển thành <bucket>/...
VITE_DEV_HLS_URL=http://localhost:9000/nxl-media
# Web quản trị riêng (nexuslive-admin). Menu avatar của tài khoản ADMIN có liên kết "Trang quản trị" mở URL này
# ở tab mới; web người dùng không chứa trang quản trị nào. Mặc định http://localhost:5174.
VITE_ADMIN_URL=http://localhost:5174
